# Copy to .env and fill in. Never commit .env.

# Discord — https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to one guild for instant updates during dev.
# Leave blank to register globally (takes up to an hour to propagate).
DISCORD_GUILD_ID=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (transcription only) — https://platform.openai.com
OPENAI_API_KEY=

# Wake word: no key or account. Every finished speech segment goes through a
# tiny local Whisper and a leading "Ralf" opens the question. The acoustic
# alternative (openWakeWord) is off by default — the trained ralf.onnx only
# recognised synthetic speech.

# --- Optional overrides (defaults in src/config.js) ---
# ANTHROPIC_MODEL=claude-sonnet-5
# STT_MODEL=gpt-4o-mini-transcribe
# PIPER_BIN=bin/piper/piper.exe
# Ralf is voiced male. Masculine voices downloaded here: alan (GB, the default),
# northern_english_male (GB), ryan (US, high quality), joe (US), lessac (US).
# Audition them with `node src/util/tts-test.js models/<voice>.onnx`.
# PIPER_VOICE=models/en_GB-alan-medium.onnx
# WAKE_GATE=false             (force /ralf-only)
# GATE_WHISPER_MODEL=tiny.en  (base.en or small.en if the name is misheard)
# GATE_MAX_MS=15000           (skip segments longer than this)
# GATE_MIN_RMS=500            (skip segments quieter than this)
#
# Acoustic wake word (openWakeWord), off unless enabled:
# WAKEWORD_ENABLED=true
# WAKEWORD_MODEL=alexa        (builtin name for testing, or path to models/ralf.onnx)
# WAKE_THRESHOLD=0.5          (0..1; lower = more sensitive, more false fires)
# WAKEWORD_PYTHON=.venv/Scripts/python.exe

# Illustrated recap: /ralf-summary draws the session with local Stable Diffusion
# and posts a PDF. Needs the separate .venv-sd environment and an NVIDIA GPU.
# ILLUSTRATE=false           (text-only recap, no GPU needed)
# SD_IMAGES=5                (scenes per recap)
# SD_STEPS=4                 (sd-turbo is distilled for 1-4)
# SD_MODEL=stabilityai/sd-turbo
# SD_SEED=1337               (empty for a different roll each time)
# SD_PYTHON=.venv-sd/Scripts/python.exe
# MAX_UPLOAD_BYTES=10485760  (Discord's limit; raise it if the server is boosted)

# Phase 2 debug: capture speech to a WAV on any voice activity (no wake word)
# and save it to tmp/ instead of transcribing. Join with /ralf-join, then talk.
# CAPTURE_TEST_MODE=true
