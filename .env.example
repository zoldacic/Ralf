# Copy to .env and fill in. Never commit .env.

# Discord — https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to one guild for instant updates during dev.
# Leave blank to register globally (takes up to an hour to propagate).
DISCORD_GUILD_ID=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (transcription only) — https://platform.openai.com
OPENAI_API_KEY=

# Wake word: openWakeWord runs locally via a Python sidecar — no key or account.
# (Replaced Picovoice Porcupine; see wakeword-openwakeword-decision note.)

# --- Optional overrides (defaults in src/config.js) ---
# ANTHROPIC_MODEL=claude-sonnet-5
# STT_MODEL=gpt-4o-mini-transcribe
# PIPER_BIN=bin/piper/piper.exe
# PIPER_VOICE=models/en_GB-alba-medium.onnx
# WAKEWORD_MODEL=alexa        (builtin name for testing, or path to models/ralf.onnx)
# WAKE_THRESHOLD=0.5          (0..1; lower = more sensitive, more false fires)
# WAKEWORD_PYTHON=.venv/Scripts/python.exe
# WAKEWORD_ENABLED=false      (force /ralf-only)

# Phase 2 debug: capture speech to a WAV on any voice activity (no wake word)
# and save it to tmp/ instead of transcribing. Join with /ralf-join, then talk.
# CAPTURE_TEST_MODE=true
